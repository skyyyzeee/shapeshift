<Page
    x:Class="Shapeshift.App.Pages.CustomizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Shapeshift.App.ViewModels"
    xmlns:c="using:Shapeshift.App.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="16" Padding="0,0,16,24">
            <StackPanel Spacing="6">
                <TextBlock x:Uid="CustomizeTitle" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Uid="CustomizeSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource BodyTextBlockStyle}" />
            </StackPanel>

            <ProgressRing HorizontalAlignment="Left" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <InfoBar IsClosable="False" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.Error, Mode=OneWay}" Severity="Error" />

            <!-- После загрузки профиля: что из него не подошло к этому образу. -->
            <InfoBar x:Uid="DroppedTweaksBar" IsClosable="True" IsOpen="{x:Bind ViewModel.HasDropped, Mode=OneWay}" Severity="Warning">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Dropped}" Margin="0,0,0,12">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </InfoBar>

            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Categories}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:TweakCategoryItem">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Margin="0,0,0,8" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                <ItemsRepeater ItemsSource="{x:Bind Tweaks}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="4" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TweakItem">
                                            <Grid Padding="0,6" ColumnSpacing="16" Visibility="{x:Bind IsVisible, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Description}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Reason}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{x:Bind HasReason}" />
                                                </StackPanel>
                                                <ToggleSwitch
                                                    Grid.Column="1"
                                                    MinWidth="0"
                                                    IsEnabled="{x:Bind IsApplicable}"
                                                    IsOn="{x:Bind IsOn, Mode=TwoWay}"
                                                    OffContent=""
                                                    OnContent=""
                                                    Tag="{x:Bind}"
                                                    Toggled="Tweak_Toggled" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- Встроенные приложения: список читается из образа, отмеченные удаляются при сборке. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Uid="AppsHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <c:InfoTip x:Uid="AppsTip" />
                        </StackPanel>
                        <Button x:Uid="AppsRecommended" Grid.Column="1" Click="AppsRecommended_Click" />
                        <Button x:Uid="AppsClear" Grid.Column="2" Click="AppsClear_Click" />
                    </Grid>
                    <TextBlock x:Uid="AppsHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    <ProgressRing HorizontalAlignment="Left" IsActive="{x:Bind ViewModel.IsLoadingApps, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoadingApps, Mode=OneWay}" />
                    <InfoBar IsClosable="False" IsOpen="{x:Bind ViewModel.HasAppsError, Mode=OneWay}" Message="{x:Bind ViewModel.AppsError, Mode=OneWay}" Severity="Error" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ShownApps}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout ItemsStretch="Fill" MinColumnSpacing="16" MinItemWidth="320" MinRowSpacing="0" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppItem">
                                <!-- Одна строка на приложение: сетка делает все ячейки высотой с первую. Предупреждение — значком с подсказкой. -->
                                <CheckBox IsChecked="{x:Bind IsOn, Mode=TwoWay}" ToolTipService.ToolTip="{x:Bind Name}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            Glyph="&#xE7BA;"
                                            ToolTipService.ToolTip="{x:Bind Note}"
                                            Visibility="{x:Bind HasNote}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- Программы: ставятся при первом входе — из winget (нужен интернет) или из своих установщиков в образе. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Uid="ProgramsHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <c:InfoTip x:Uid="ProgramsTip" />
                    </StackPanel>
                    <TextBlock x:Uid="ProgramsHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Programs.Suggestions}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout ItemsStretch="Fill" MinColumnSpacing="16" MinItemWidth="200" MinRowSpacing="0" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProgramSuggestionItem">
                                <CheckBox Content="{x:Bind Title}" IsChecked="{x:Bind IsOn, Mode=TwoWay}" ToolTipService.ToolTip="{x:Bind WingetId}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WingetIdBox" x:Uid="WingetIdBox" KeyDown="WingetIdBox_KeyDown" />
                        <Button x:Uid="AddWinget" Grid.Column="1" Click="AddWinget_Click" />
                        <c:InfoTip x:Uid="WingetIdTip" Grid.Column="2" />
                    </Grid>
                    <InfoBar IsClosable="False" IsOpen="{x:Bind ViewModel.Programs.HasAddError, Mode=OneWay}" Message="{x:Bind ViewModel.Programs.AddError, Mode=OneWay}" Severity="Warning" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="AddInstaller" Click="AddInstaller_Click" />
                        <Button x:Uid="AddInstallerFolder" Click="AddInstallerFolder_Click" />
                        <c:InfoTip x:Uid="AddInstallerTip" />
                    </StackPanel>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Programs.Added}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProgramItem">
                                <Grid Padding="0,6,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="8" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button x:Uid="RemoveProgram" Grid.Column="1" VerticalAlignment="Top" Click="RemoveProgram_Click" Tag="{x:Bind}" />
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind IsLocal}">
                                        <ComboBox MinWidth="160" ItemsSource="{x:Bind RunChoices}" SelectedItem="{x:Bind Run, Mode=TwoWay}" Visibility="{x:Bind IsFolder}" />
                                        <TextBox MinWidth="320" PlaceholderText="{x:Bind ArgsHint, Mode=OneWay}" Text="{x:Bind Args, Mode=TwoWay}" />
                                        <c:InfoTip x:Uid="ProgramArgsTip" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- Обои рабочего стола: картинка копируется в образ; закреплённые политиками нельзя сменить. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Uid="WallpaperHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <c:InfoTip x:Uid="WallpaperTip" />
                    </StackPanel>
                    <TextBlock x:Uid="WallpaperHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="192"
                            Height="108"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <Grid>
                                <FontIcon FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE91B;" />
                                <Image x:Name="WallpaperPreview" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.Wallpaper.FileName, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.Wallpaper.Path, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Uid="WallpaperPick" Click="WallpaperPick_Click" />
                                <Button x:Uid="WallpaperClear" Click="WallpaperClear_Click" IsEnabled="{x:Bind ViewModel.Wallpaper.HasPicture, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.Wallpaper.HasPicture, Mode=OneWay}">
                                <ComboBox x:Uid="WallpaperStyleBox" MinWidth="160" ItemsSource="{x:Bind ViewModel.Wallpaper.StyleChoices}" SelectedIndex="{x:Bind ViewModel.Wallpaper.StyleIndex, Mode=TwoWay}" />
                                <c:InfoTip x:Uid="WallpaperStyleTip" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.Wallpaper.HasPicture, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="WallpaperLocked" TextWrapping="Wrap" />
                            <TextBlock x:Uid="WallpaperLockedHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" MinWidth="0" IsOn="{x:Bind ViewModel.Wallpaper.Locked, Mode=TwoWay}" OffContent="" OnContent="" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
