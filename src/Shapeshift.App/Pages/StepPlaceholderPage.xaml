<Page
    x:Class="Shapeshift.App.Pages.StepPlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="6">
        <TextBlock x:Name="StepTitle" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock
            x:Uid="StepComingSoon"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}" />
    </StackPanel>
</Page>
