<Page
    x:Class="Shapeshift.App.Pages.EditionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Shapeshift.App.ViewModels"
    xmlns:c="using:Shapeshift.App.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="16" Padding="0,0,16,24">
            <StackPanel Spacing="6">
                <TextBlock x:Uid="EditionsTitle" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Uid="EditionsSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource BodyTextBlockStyle}" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="KeepEditionsHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Uid="KeepEditionsHint"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Editions}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:EditionChoice">
                                <CheckBox IsChecked="{x:Bind IsKept, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{x:Bind Name}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind EditionId}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock
                        x:Uid="NoEditionKept"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Visibility="{x:Bind ViewModel.HasNoneKept, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Uid="InstallEditionHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <c:InfoTip x:Uid="InstallEditionTip" />
                    </StackPanel>
                    <TextBlock
                        x:Uid="InstallEditionHint"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        MinWidth="320"
                        ItemsSource="{x:Bind ViewModel.InstallChoices}"
                        SelectedItem="{x:Bind ViewModel.Install, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- Компоненты Windows, которые включаются в образе офлайн (DISM). -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="ComponentsHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Uid="DotNet35Name" TextWrapping="Wrap" />
                                <c:InfoTip x:Uid="DotNet35Tip" />
                            </StackPanel>
                            <TextBlock x:Uid="DotNet35Hint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" MinWidth="0" IsOn="{x:Bind ViewModel.DotNet35, Mode=TwoWay}" OffContent="" OnContent="" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Языки интерфейса: пакеты из Windows Update ставит DISM при сборке; язык Windows — в файле ответов. -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Uid="LanguagesHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <c:InfoTip x:Uid="LanguagesTip" />
                    </StackPanel>
                    <TextBlock
                        x:Uid="LanguagesHint"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Uid="LanguagesInImage" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.Languages.InstalledText, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>

                    <ProgressRing HorizontalAlignment="Left" IsActive="{x:Bind ViewModel.Languages.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.Languages.IsLoading, Mode=OneWay}" />
                    <InfoBar IsClosable="False" IsOpen="{x:Bind ViewModel.Languages.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.Languages.Error, Mode=OneWay}" Severity="Warning">
                        <InfoBar.ActionButton>
                            <Button x:Uid="LanguagesRetry" Click="LanguagesRetry_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.Languages.CanChoose, Mode=OneWay}">
                        <ComboBox
                            x:Uid="LanguageToAdd"
                            MinWidth="320"
                            ItemsSource="{x:Bind ViewModel.Languages.AddChoices}"
                            SelectedItem="{x:Bind ViewModel.Languages.ToAdd, Mode=TwoWay}" />
                        <Button
                            x:Uid="LanguageAdd"
                            VerticalAlignment="Bottom"
                            Click="LanguageAdd_Click"
                            IsEnabled="{x:Bind ViewModel.Languages.CanAdd, Mode=OneWay}" />
                    </StackPanel>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Languages.Added}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:LanguageItem">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Label}" TextWrapping="Wrap" />
                                    <Button x:Uid="LanguageRemove" Grid.Column="1" Click="LanguageRemove_Click" Tag="{x:Bind}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox
                            x:Uid="DisplayLanguage"
                            MinWidth="320"
                            ItemsSource="{x:Bind ViewModel.Languages.DisplayChoices}"
                            SelectedItem="{x:Bind ViewModel.Languages.Display, Mode=TwoWay}" />
                        <c:InfoTip x:Uid="DisplayLanguageTip" Margin="0,0,0,8" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock
                        x:Uid="LanguagesUpdateNote"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.Languages.HasAdded, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
