{
  // Полностью автоматическая установка: стенд подставит source.iso и output.iso сам.
  "formatVersion": 1,
  // Все твики каталога — стенд проверяет, что они дошли до установленной системы.
  "tweaks": [
    "bypass.tpm", "bypass.secure-boot", "bypass.ram", "bypass.cpu",
    "privacy.telemetry", "privacy.advertising-id", "privacy.activity-history", "privacy.suggestions",
    "privacy.web-search", "privacy.recall",
    "interface.classic-context-menu", "interface.taskbar-left", "interface.no-widgets",
    "interface.file-extensions", "interface.dark-theme",
    "system.no-device-encryption", "system.no-hibernation"
  ],
  // Только Pro: установщик должен принять WIM, пересобранный wimlib.
  "editions": ["Professional"],
  "setup": {
    // Тестовая учётная запись одноразовой ВМ. Пароль хранится, чтобы стенд мог войти через PowerShell Direct.
    "user": { "name": "Bench", "password": { "mode": "store", "value": "Bench-Pass-1" }, "autoLogon": true },
    "computerName": "SHAPESHIFT-VM",
    "skipOobe": true,
    "bypassOnlineAccount": true,
    "wipeDisk0": true,
    "edition": "Professional"
  },
  // Свой установщик (путь — от папки сценария) и пакет winget: в ВМ нет сети, он должен быть пропущен.
  "programs": [
    { "path": "programs/marker.cmd", "args": "C:\\ProgramData\\ShapeshiftBench\\marker.txt", "name": "Bench marker" },
    { "winget": "7zip.7zip" }
  ],
  // Закреплённые обои (путь — от папки сценария): политики и запрет смены.
  "wallpaper": { "path": "wallpaper.png", "style": "fill" },
  "regional": {
    "formats": "ru-RU",
    "keyboards": ["en-US", "ru-RU"],
    "timeZone": "Russian Standard Time"
  }
}
